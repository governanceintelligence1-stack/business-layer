APP_NAME="Governance Intelligence Portal"
APP_ENV=production
APP_URL=https://my.gismartanalytics.com
APP_DEBUG=false

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gi_portal
DB_USERNAME=gi_user
DB_PASSWORD=replace-with-db-password
DB_SSLMODE=disable

# Keycloak SSO
KEYCLOAK_URL=https://auth.gismartanalytics.com
KEYCLOAK_REALM=gi
KEYCLOAK_CLIENT_ID=business-layer
KEYCLOAK_CLIENT_SECRET=replace-with-keycloak-client-secret
KEYCLOAK_REDIRECT_URI=https://my.gismartanalytics.com/auth/callback
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=https://my.gismartanalytics.com

# Sessions
SESSION_SECRET=replace-with-long-random-session-secret

# Development bypass
AUTH_BYPASS=false
AUTH_BYPASS_USER_EMAIL=test.user@gismartanalytics.com
DEFAULT_ORGANISATION_SLUG=governance-intelligence-test

# PayFast
PAYFAST_ENV=sandbox
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=replace-with-payfast-merchant-id
PAYFAST_MERCHANT_KEY=replace-with-payfast-merchant-key
PAYFAST_PASSPHRASE=replace-with-payfast-passphrase-if-used

PAYFAST_RETURN_URL=https://my.gismartanalytics.com/checkout/return
PAYFAST_CANCEL_URL=https://my.gismartanalytics.com/checkout/cancel
PAYFAST_NOTIFY_URL=https://my.gismartanalytics.com/checkout/notify

# PayFast ITN validation
PAYFAST_NOTIFY_SKIP_SIGNATURE=false
PAYFAST_ITN_SKIP_IP_VALIDATION=false
PAYFAST_ITN_SKIP_SERVER_VALIDATION=false