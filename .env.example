APP_NAME="Governance Intelligence Portal"
APP_ENV=production
APP_URL=https://my.gismartanalytics.com
APP_DEBUG=false

# PostgreSQL (local: same host/port as pgAdmin connection; create DB/user to match)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gi_portal
DB_USERNAME=gi_user
DB_PASSWORD=secret

KEYCLOAK_URL=https://auth.gismartanalytics.com
KEYCLOAK_REALM=gi
KEYCLOAK_CLIENT_ID=business-layer
KEYCLOAK_CLIENT_SECRET=your-client-secret
KEYCLOAK_REDIRECT_URI=https://my.gismartanalytics.com/auth/callback

SESSION_SECRET=change-this-to-a-random-secret
AUTH_BYPASS=false
# When AUTH_BYPASS=true, load this user from the DB (must exist after pgAdmin seed script)
AUTH_BYPASS_USER_EMAIL=test.user@gismartanalytics.com
# Keycloak upsert fallback org slug from seed script
DEFAULT_ORGANISATION_SLUG=governance-intelligence-test

PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=
PAYFAST_RETURN_URL=https://my.gismartanalytics.com/checkout/return
PAYFAST_CANCEL_URL=https://my.gismartanalytics.com/checkout/cancel
PAYFAST_NOTIFY_URL=https://my.gismartanalytics.com/checkout/notify
# Local ITN tests only: allows POST /checkout/notify without a valid PayFast signature
PAYFAST_NOTIFY_SKIP_SIGNATURE=false
